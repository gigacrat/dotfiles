#!/usr/bin/env bash
#
# Refuse to commit secrets. This repository is public.
#
# Lives in .githooks/ rather than .git/hooks/ so it is version controlled and
# survives a fresh clone. Activate it once per clone with:
#
#   git config core.hooksPath .githooks
#
# Bypass only when a finding is a confirmed false positive:
#
#   git commit --no-verify

set -euo pipefail

red() { printf '\033[31m%s\033[0m\n' "$1" >&2; }

if ! command -v gitleaks >/dev/null 2>&1; then
    red "pre-commit: gitleaks not found; refusing to commit."
    printf 'This repo is public and relies on gitleaks as its backstop.\n' >&2
    printf 'Install it with:  omarchy pkg add gitleaks\n' >&2
    exit 1
fi

if ! gitleaks git --staged --redact --no-banner; then
    red "pre-commit: gitleaks found a secret in the staged changes."
    printf 'Nothing was committed.\n\n' >&2
    printf 'Note that staging already wrote the content to .git as a blob. After\n' >&2
    printf 'unstaging, purge it so it cannot be published:\n' >&2
    printf '  git reset <file> && git gc --prune=now\n\n' >&2
    printf 'If this is a false positive, add a rule to .gitleaks.toml.\n' >&2
    exit 1
fi
